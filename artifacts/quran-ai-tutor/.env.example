# URL of the deployed Next.js backend (apps/web).
# Local dev against localhost: use your machine's LAN IP so Expo Go on your
# phone can reach it — e.g. http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=https://your-backend.vercel.app

# Supabase — same project as the backend. Values from Supabase dashboard:
#   Project Settings → API → URL and "anon" public key.
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>
